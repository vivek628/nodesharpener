<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="input.css">
    <title>Document</title>
</head>
<body>
    <div class="container">
        <h2>Add Expense</h2>
        <form action="<%= editmode ? '/detail' : '/detail' %>" method="post">
            <div class="form-group">
                <label for="expenseDate">Date:</label>
                <input type="date" id="expenseDate" name="expenseDate" required value="<%= editmode ? date.toISOString().slice(0, 10)  : '' %>">
            </div>
            <div class="form-group">
                <label for="expenseDetail">Expense Detail:</label>
                <input type="text" id="expenseDetail" name="expenseDetail" required value="<%= editmode ? expenseDetail : '' %>">
            </div>
            <div class="form-group">
                <label for="expenseAmount">Amount ($):</label>
                <input type="number" id="expenseAmount" name="expenseAmount" min="0.01" step="0.01" required value="<%= editmode ? amount : '' %>">
            </div>
            <input type="submit" value="Submit">
        </form>
    </div>
</body>
</html>